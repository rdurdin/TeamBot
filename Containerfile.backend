FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY requirements.txt ./requirements-root.txt
COPY backend/requirements.txt ./requirements-web.txt
RUN pip install --no-cache-dir -r requirements-root.txt -r requirements-web.txt

COPY core/ ./core/
COPY storage/ ./storage/
COPY backend/api.py ./backend/api.py

WORKDIR /app/backend

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
